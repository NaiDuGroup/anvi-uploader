# PostgreSQL connection string (required)
# Local:    postgresql://printadmin:printadmin@localhost:5432/printupload
# Neon:     postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Direct (non-pooler) connection for Prisma migrations (required for Neon).
# Use the same credentials but WITHOUT "-pooler" in the hostname.
# Neon:     postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=30
# Local:    same as DATABASE_URL
DIRECT_DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Optional: only for npm run db:sync-from-prod (copy prod → local). Do not commit real values.
# Prefer: export PROD_DATABASE_URL='postgresql://...' in your shell before running the script.
# PROD_DATABASE_URL="postgresql://user:password@prod-host:5432/dbname?sslmode=require"

# Cloudflare R2 (required for file uploads)
# Main bucket — private order files, lifecycle-expired (e.g. 7 days).
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="print-uploads"
# Optional: public R2 dev URL or custom domain for the main bucket (rarely used).
# R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxx.r2.dev"

# Catalog bucket — public, long-lived assets (mug/notebook catalog photos, company logo).
# Same R2 account/credentials; create a second bucket and enable Public Access on it.
# If unset, all uploads/downloads fall back to the main bucket (single-bucket mode).
R2_CATALOG_BUCKET_NAME="anvi-catalog"
# Public r2.dev URL (or custom domain) for the catalog bucket. When set, client
# <img> tags fetch catalog photos directly via this URL instead of the
# /api/public/file proxy.
R2_CATALOG_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxx.r2.dev"

# AWS S3 (optional — if set, presigned upload/download use AWS instead of R2)
# AWS_REGION="eu-central-1"
# AWS_ACCESS_KEY_ID="…"
# AWS_SECRET_ACCESS_KEY="…"
# AWS_S3_BUCKET="your-bucket-name"
# AWS_S3_CATALOG_BUCKET="your-catalog-bucket-name"

# Vercel Cron secret (protects /api/cron/* endpoints)
# Daily e-Factura sync: /api/cron/efactura-sync (vercel.json → 04:00 UTC)
# CRON_SECRET="generate-a-random-secret-here"

# e-Factura (SFS Moldova) integration. Leave EFACTURA_MODE unset (or not "live")
# to use built-in mock data. Set to "live" plus the dedicated API user
# credentials (created in e-Factura: Setări → Utilizatorii companiei →
# "Creează un utilizator API", requires Manager role) to pull real invoices.
# EFACTURA_MODE="live"
# EFACTURA_USERNAME="your-api-user"
# EFACTURA_PASSWORD="your-api-password"
# Optional; defaults to the official endpoint below.
# EFACTURA_ENDPOINT="https://efactura-api.sfs.md/Service.svc"

# Public URL of the notebook hardcover GLB (~21 MB, served from R2/CDN in prod).
# Leave unset in dev to fall back to the local file in /public.
# NEXT_PUBLIC_NOTEBOOK_GLB_URL="https://cdn.example.com/anvi/notebook_hardcover_with_strap_A5_v3.1_Cycles.glb"
