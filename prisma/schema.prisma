generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id           String        @id @default(uuid())
  orderNumber  Int           @unique @default(autoincrement()) @map("order_number")
  phone        String
  status       String        @default("NEW")
  assignedTo   String?       @map("assigned_to")
  isWorkshop   Boolean       @default(false) @map("is_workshop")
  isPrio       Boolean       @default(false) @map("is_prio")
  price        Int?
  isPaid       Boolean       @default(false) @map("is_paid")
  notes        String?
  issueReason  String?       @map("issue_reason")
  createdBy          String?       @map("created_by")
  sentToWorkshopBy   String?       @map("sent_to_workshop_by")
  clientName         String?       @map("client_name")
  clientId           String?       @map("client_id")
  productType        String        @default("paper_print") @map("product_type")
  mugLayoutData      Json?         @map("mug_layout_data")
  mugProductId       String?       @map("mug_product_id")
  mugProductSnapshot Json?         @map("mug_product_snapshot")
  approvalFeedback   String?       @map("approval_feedback")
  publicToken        String        @unique @map("public_token")
  expiresAt          DateTime      @map("expires_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  deletedAt          DateTime?     @map("deleted_at")
  files              File[]
  comments           Comment[]
  commentReads       CommentRead[]
  logs               OrderLog[]
  creator            User?         @relation("createdOrders", fields: [createdBy], references: [id])
  workshopSender     User?         @relation("sentToWorkshopOrders", fields: [sentToWorkshopBy], references: [id])
  studioClient       StudioCustomer? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  mugProduct         MugProduct?   @relation(fields: [mugProductId], references: [id], onDelete: SetNull)
  mugStockMovements  MugStockMovement[]

  @@index([clientId])
  @@index([deletedAt])
  @@index([mugProductId])
  @@map("orders")
}

model MugProduct {
  id             String   @id @default(uuid())
  sku            String   @unique
  nameRo         String   @map("name_ro")
  nameRu         String   @map("name_ru")
  nameEn         String   @map("name_en")
  stockQuantity  Int      @default(0) @map("stock_quantity")
  sellPrice      Int?     @map("sell_price")
  dealerPrice    Int?     @map("dealer_price")
  imageUrl       String?  @map("image_url")
  bodyColorHex   String   @default("#f5f5f0") @map("body_color_hex")
  handleColorHex String   @default("#a8a29e") @map("handle_color_hex")
  innerColorHex  String?  @map("inner_color_hex")
  // Rim lip (GLB mesh Mug_Fringe); null uses body color in 3D
  rimColorHex    String?  @map("rim_color_hex")
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")
  internalNotes  String?  @map("internal_notes")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdById    String?  @map("created_by_id")
  createdBy      User?    @relation("mugProductsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  orders          Order[]
  stockMovements  MugStockMovement[]

  @@index([isActive])
  @@index([sortOrder])
  @@map("mug_products")
}

// Audit trail for mug SKU stock: sales, restores, receipts.
model MugStockMovement {
  id           String   @id @default(uuid())
  mugProductId String   @map("mug_product_id")
  delta        Int
  kind         String   @map("kind")
  orderId      String?  @map("order_id")
  orderNumber  Int?     @map("order_number")
  note         String?  @map("note")
  createdById  String?  @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  mugProduct MugProduct @relation(fields: [mugProductId], references: [id], onDelete: Cascade)
  order      Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy  User?      @relation("mugStockCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([mugProductId, createdAt(sort: Desc)])
  @@index([orderId])
  @@map("mug_stock_movements")
}

// Studio customer registry (table clients). Model name avoids prisma.client delegate ambiguity.
model StudioCustomer {
  id               String   @id @default(uuid())
  kind             String
  phone            String?
  phoneNormalized  String?  @map("phone_normalized")
  personName       String?  @map("person_name")
  companyName      String?  @map("company_name")
  companyIdno      String?  @map("company_idno")
  companyIban      String?  @map("company_iban")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  orders           Order[]

  @@index([phoneNormalized])
  @@map("clients")
}

model File {
  id        String  @id @default(uuid())
  orderId   String  @map("order_id")
  fileUrl   String  @map("file_url")
  fileName  String  @map("file_name")
  copies    Int     @default(1)
  color     String  @default("bw")
  paperType String? @map("paper_type")
  pageCount Int?    @map("page_count")
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("files")
}

model User {
  id            String    @id @default(uuid())
  name          String
  displayName   String?   @map("display_name")
  role          String    @default("admin")
  password      String
  sessions              Session[]
  comments              Comment[]
  createdOrders         Order[]   @relation("createdOrders")
  sentToWorkshopOrders  Order[]   @relation("sentToWorkshopOrders")
  mugProductsCreated    MugProduct[] @relation("mugProductsCreated")
  mugStockMovementsCreated MugStockMovement[] @relation("mugStockCreatedBy")

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Comment {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  userId    String   @map("user_id")
  text      String
  createdAt DateTime @default(now()) @map("created_at")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@map("comments")
}

model CommentRead {
  id      String   @id @default(uuid())
  orderId String   @map("order_id")
  userId  String   @map("user_id")
  readAt  DateTime @default(now()) @map("read_at")
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, userId])
  @@map("comment_reads")
}

model OrderLog {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  userId    String   @map("user_id")
  action    String
  field     String?
  oldValue  String?  @map("old_value")
  newValue  String?  @map("new_value")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_logs")
}
