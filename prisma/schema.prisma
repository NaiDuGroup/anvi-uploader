generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model Order {
  id                       String                    @id @default(uuid())
  orderNumber              Int                       @unique @default(autoincrement()) @map("order_number")
  phone                    String
  status                   String                    @default("NEW")
  assignedTo               String?                   @map("assigned_to")
  isWorkshop               Boolean                   @default(false) @map("is_workshop")
  isPrio                   Boolean                   @default(false) @map("is_prio")
  /// Order total in MDL with bani precision. Set from catalog tier × copies on public/cabinet order create, or edited manually in the admin order wizard.
  price                    Decimal?                  @db.Decimal(12, 2)
  isPaid                   Boolean                   @default(false) @map("is_paid")
  /// When the order was marked paid (manual toggle, bulk client mark-paid, or DELIVERED auto-pay). Null for orders paid before this field existed.
  paidAt                   DateTime?                 @map("paid_at")
  notes                    String?
  issueReason              String?                   @map("issue_reason")
  createdBy                String?                   @map("created_by")
  sentToWorkshopBy         String?                   @map("sent_to_workshop_by")
  clientName               String?                   @map("client_name")
  clientId                 String?                   @map("client_id")
  productType              String                    @default("paper_print") @map("product_type")
  mugLayoutData            Json?                     @map("mug_layout_data")
  mugProductId             String?                   @map("mug_product_id")
  mugProductSnapshot       Json?                     @map("mug_product_snapshot")
  notebookLayoutData       Json?                     @map("notebook_layout_data")
  notebookProductId        String?                   @map("notebook_product_id")
  notebookProductSnapshot  Json?                     @map("notebook_product_snapshot")
  penLayoutData            Json?                     @map("pen_layout_data")
  penProductId             String?                   @map("pen_product_id")
  penProductSnapshot       Json?                     @map("pen_product_snapshot")
  approvalFeedback         String?                   @map("approval_feedback")
  publicToken              String                    @unique @map("public_token")
  expiresAt                DateTime                  @map("expires_at")
  createdAt                DateTime                  @default(now()) @map("created_at")
  deletedAt                DateTime?                 @map("deleted_at")
  /// Mug/notebook catalog order could not deduct stock at creation / restore — needs purchase first.
  needsProcurement         Boolean                   @default(false) @map("needs_procurement")
  /// { kind, productId, sku?, requestedQty, stockAtOrder } for admin display.
  procurementMeta          Json?                     @map("procurement_meta")
  files                    File[]
  orderLines               OrderLine[]
  comments                 Comment[]
  commentReads             CommentRead[]
  clientMessages           ClientMessage[]
  clientMessageReads       ClientMessageRead[]
  logs                     OrderLog[]
  creator                  User?                     @relation("createdOrders", fields: [createdBy], references: [id])
  workshopSender           User?                     @relation("sentToWorkshopOrders", fields: [sentToWorkshopBy], references: [id])
  studioClient             StudioCustomer?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  mugProduct               MugProduct?               @relation(fields: [mugProductId], references: [id], onDelete: SetNull)
  mugStockMovements        MugStockMovement[]
  notebookProduct          NotebookProduct?          @relation(fields: [notebookProductId], references: [id], onDelete: SetNull)
  notebookStockMovements   NotebookStockMovement[]
  penProduct               PenProduct?               @relation(fields: [penProductId], references: [id], onDelete: SetNull)
  penStockMovements        PenStockMovement[]
  inkStockMovements        InkStockMovement[]
  lfRollStockMovements     LfRollStockMovement[]
  sheetPaperStockMovements SheetPaperStockMovement[]
  garmentStockMovements    GarmentStockMovement[]
  dtfConsumableMovements   DtfConsumableMovement[]
  invoiceLineItems         InvoiceLineItem[]         @relation("orderInvoiceLines")
  stockMovements           StockMovement[]

  @@index([clientId])
  @@index([deletedAt])
  @@index([deletedAt, isPrio, createdAt(sort: Desc)])
  @@index([deletedAt, isWorkshop, createdAt(sort: Desc)])
  @@index([deletedAt, status, createdAt(sort: Desc)])
  @@index([deletedAt, createdBy, createdAt(sort: Desc)])
  @@index([deletedAt, needsProcurement, createdAt(sort: Desc)])
  @@index([mugProductId])
  @@index([notebookProductId])
  @@index([penProductId])
  @@index([needsProcurement])
  @@map("orders")
}

model MugProduct {
  id              String             @id @default(uuid())
  sku             String             @unique
  nameRo          String             @map("name_ro")
  nameRu          String             @map("name_ru")
  nameEn          String             @map("name_en")
  stockQuantity   Int                @default(0) @map("stock_quantity")
  sellPrice       Decimal?           @map("sell_price") @db.Decimal(12, 2)
  dealerPrice     Decimal?           @map("dealer_price") @db.Decimal(12, 2)
  /// Catalog purchase hint (MDL per unit); used for COGS while `avgPurchaseCost` is null.
  purchaseCost    Decimal?           @map("purchase_cost") @db.Decimal(12, 2)
  /// Weighted-average purchase cost (MDL per unit) rolled forward on every stock receipt.
  avgPurchaseCost Decimal?           @map("avg_purchase_cost") @db.Decimal(14, 4)
  imageUrl        String?            @map("image_url")
  bodyColorHex    String             @default("#f5f5f0") @map("body_color_hex")
  handleColorHex  String             @default("#a8a29e") @map("handle_color_hex")
  innerColorHex   String?            @map("inner_color_hex")
  // Rim lip (GLB mesh Mug_Fringe); null uses body color in 3D
  rimColorHex     String?            @map("rim_color_hex")
  // Print area for the wraparound layout (cm × cm at `printDpi`).
  // Defaults match the legacy hardcoded canvas (2480 × 1134 px @ 300 DPI ≈ 21 × 9.6 cm).
  printWidthCm    Decimal            @default(21.0) @map("print_width_cm") @db.Decimal(5, 2)
  printHeightCm   Decimal            @default(9.6) @map("print_height_cm") @db.Decimal(5, 2)
  printDpi        Int                @default(300) @map("print_dpi")
  // When false, the editor / approval pages skip Mug3DPreview entirely
  // (used while we don't have a GLB for non-standard mug shapes).
  has3dPreview    Boolean            @default(true) @map("has_3d_preview")
  isActive        Boolean            @default(true) @map("is_active")
  sortOrder       Int                @default(0) @map("sort_order")
  internalNotes   String?            @map("internal_notes")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  createdById     String?            @map("created_by_id")
  createdBy       User?              @relation("mugProductsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  orders          Order[]
  orderLines      OrderLine[]
  stockMovements  MugStockMovement[]
  stockReceipts   MugStockReceipt[]
  designs         Design[]

  @@index([isActive])
  @@index([sortOrder])
  @@map("mug_products")
}

model NotebookProduct {
  id               String                  @id @default(uuid())
  sku              String                  @unique
  nameRo           String                  @map("name_ro")
  nameRu           String                  @map("name_ru")
  nameEn           String                  @map("name_en")
  stockQuantity    Int                     @default(0) @map("stock_quantity")
  sellPrice        Decimal?                @map("sell_price") @db.Decimal(12, 2)
  dealerPrice      Decimal?                @map("dealer_price") @db.Decimal(12, 2)
  /// Catalog purchase hint (MDL per unit); used for COGS while `avgPurchaseCost` is null.
  purchaseCost     Decimal?                @map("purchase_cost") @db.Decimal(12, 2)
  /// Weighted-average purchase cost (MDL per unit) rolled forward on every stock receipt.
  avgPurchaseCost  Decimal?                @map("avg_purchase_cost") @db.Decimal(14, 4)
  imageUrl         String?                 @map("image_url")
  // Hardcover (GLB mesh `cover_A5`) — single piece front+spine+back
  coverColorHex    String                  @default("#1f1f1f") @map("cover_color_hex")
  // Elastic strap (GLB mesh `strap_A5`)
  strapColorHex    String                  @default("#1f1f1f") @map("strap_color_hex")
  // Bookmark ribbon (GLB mesh `bookmark_A5`)
  bookmarkColorHex String                  @default("#c0392b") @map("bookmark_color_hex")
  // Paper layout inside the notebook: "ruled" (linii), "squared" (clete), "dated" (datat).
  paperKind        String                  @default("ruled") @map("paper_kind")
  // Print area for the hardcover layout (cm × cm at `printDpi`).
  // Defaults match A5 hardcover (1654 × 2528 px @ 300 DPI ≈ 14 × 21.4 cm).
  printWidthCm     Decimal                 @default(14.0) @map("print_width_cm") @db.Decimal(5, 2)
  printHeightCm    Decimal                 @default(21.4) @map("print_height_cm") @db.Decimal(5, 2)
  printDpi         Int                     @default(300) @map("print_dpi")
  // When false, the editor / approval pages skip Notebook3DPreview entirely
  // (used while we don't have a GLB for non-A5 hardcovers).
  has3dPreview     Boolean                 @default(true) @map("has_3d_preview")
  isActive         Boolean                 @default(true) @map("is_active")
  sortOrder        Int                     @default(0) @map("sort_order")
  internalNotes    String?                 @map("internal_notes")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  createdById      String?                 @map("created_by_id")
  createdBy        User?                   @relation("notebookProductsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  orders           Order[]
  orderLines       OrderLine[]
  stockMovements   NotebookStockMovement[]
  stockReceipts    NotebookStockReceipt[]
  designs          Design[]

  @@index([isActive])
  @@index([sortOrder])
  @@map("notebook_products")
}

// Audit trail for notebook SKU stock: sales, restores, receipts.
model NotebookStockMovement {
  id                String   @id @default(uuid())
  notebookProductId String   @map("notebook_product_id")
  delta             Int
  kind              String   @map("kind")
  orderId           String?  @map("order_id")
  orderNumber       Int?     @map("order_number")
  /// Receipt: purchase total; sale / return: quantity × weighted-average cost at that moment.
  costMdl           Decimal? @map("cost_mdl") @db.Decimal(14, 2)
  note              String?  @map("note")
  createdById       String?  @map("created_by_id")
  createdAt         DateTime @default(now()) @map("created_at")

  notebookProduct NotebookProduct @relation(fields: [notebookProductId], references: [id], onDelete: Cascade)
  order           Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy       User?           @relation("notebookStockCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([notebookProductId, createdAt(sort: Desc)])
  @@index([orderId])
  @@map("notebook_stock_movements")
}

/// Purchase receipt for notebook SKU stock (weighted-average basis).
model NotebookStockReceipt {
  id                    String   @id @default(uuid())
  notebookProductId     String   @map("notebook_product_id")
  quantity              Int
  totalCostMdl          Decimal  @map("total_cost_mdl") @db.Decimal(14, 2)
  purchasedAt           DateTime @map("purchased_at") @db.Date
  supplier              String?  @db.Text
  note                  String?  @db.Text
  createdById           String?  @map("created_by_id")
  createdAt             DateTime @default(now()) @map("created_at")
  /// Set when the receipt was posted from an incoming e-Factura line.
  purchaseInvoiceLineId String?  @unique @map("purchase_invoice_line_id")
  /// Provisional receipt: priced at the last known unit cost until the supplier invoice arrives.
  isProvisional         Boolean  @default(false) @map("is_provisional")
  /// Legacy receipts were entered VAT-inclusive; new ones follow `AccountingSettings.purchaseCostsIncludeVat`.
  amountsIncludeVat     Boolean  @default(true) @map("amounts_include_vat")

  notebookProduct     NotebookProduct      @relation(fields: [notebookProductId], references: [id], onDelete: Cascade)
  purchaseInvoiceLine PurchaseInvoiceLine? @relation(fields: [purchaseInvoiceLineId], references: [id], onDelete: SetNull)
  createdBy           User?                @relation("notebookReceiptsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([notebookProductId, purchasedAt(sort: Desc)])
  @@map("notebook_stock_receipts")
}

