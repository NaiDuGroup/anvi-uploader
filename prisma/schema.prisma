/// Wide-format roll media catalog + weighted-average roll stock.
model LargeFormatMaterial {
  id                                   String                 @id @default(uuid())
  /// Unified stock variant holding this roll's balance and cost (pricing settings stay here).
  stockVariantId                       String?                @unique @map("stock_variant_id")
  name                                 String
  rollWidthMeters                      Decimal                @map("roll_width_m") @db.Decimal(8, 3)
  /// Effective printable width across the roll (meters). When null, server derives `rollWidthMeters − LF trim`.
  printableWidthMeters                 Decimal?               @map("printable_width_m") @db.Decimal(8, 3)
  rollLengthMeters                     Decimal?               @map("roll_length_m") @db.Decimal(8, 3)
  /// Current stock balance (linear meters).
  stockLinearMeters                    Decimal                @default(0) @map("stock_linear_m") @db.Decimal(14, 3)
  /// Weighted-average purchase cost (MDL per linear meter). Null until first receipt; COGS falls back to `costPerLinearMeter`.
  avgPurchaseCostPerLinearMeter        Decimal?               @map("avg_purchase_cost_per_lm") @db.Decimal(14, 4)
  /// Legacy catalog purchase hint (MDL integer per linear m); used when `avgPurchaseCostPerLinearMeter` is null.
  costPerLinearMeter                   Int                    @map("cost_per_lm")
  dealerPricePerLinearMeter            Int                    @map("dealer_price_per_lm")
  retailPricePerLinearMeter            Int                    @map("retail_price_per_lm")
  dealerPrintPricePerLinearMeter       Int                    @map("dealer_print_price_per_lm")
  retailPrintPricePerLinearMeter       Int                    @map("retail_print_price_per_lm")
  /// Unified catalog sell rate (MDL per linear m, retail): replaces material+print split for quotes.
  finalRetailPricePerLinearMeter       Int                    @default(0) @map("final_retail_price_per_lm")
  /// Unified catalog sell rate (MDL per linear m, dealer).
  finalDealerPricePerLinearMeter       Int                    @default(0) @map("final_dealer_price_per_lm")
  /// When set, overrides formula/legacy for retail channel (MDL per linear m).
  manualFinalRetailPricePerLinearMeter Int?                   @map("manual_final_retail_price_per_lm")
  /// When set, overrides formula/legacy for dealer channel (MDL per linear m).
  manualFinalDealerPricePerLinearMeter Int?                   @map("manual_final_dealer_price_per_lm")
  isActive                             Boolean                @default(true) @map("is_active")
  sortOrder                            Int                    @default(0) @map("sort_order")
  createdAt                            DateTime               @default(now()) @map("created_at")
  updatedAt                            DateTime               @updatedAt @map("updated_at")
  orderLines                           OrderLine[]
  rollReceipts                         LfRollStockReceipt[]
  stockMovements                       LfRollStockMovement[]
  sizePresets                          LfMaterialSizePreset[]
  stockVariant                         StockVariant?          @relation("lfMaterialStock", fields: [stockVariantId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([sortOrder])
  @@map("large_format_materials")
}

/// Per-material size preset (price list): final retail/dealer price for a fixed width×height.
/// When picked in the order wizard, replaces the auto pricing pipeline for that line.
model LfMaterialSizePreset {
  id             String   @id @default(uuid())
  materialId     String   @map("material_id")
  widthCm        Int      @map("width_cm")
  heightCm       Int      @map("height_cm")
  retailPriceMdl Int      @map("retail_price_mdl")
  dealerPriceMdl Int      @map("dealer_price_mdl")
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  material LargeFormatMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, widthCm, heightCm])
  @@index([materialId, sortOrder])
  @@map("lf_material_size_presets")
}

/// Purchase receipt for roll stock (weighted-average basis).
model LfRollStockReceipt {
  id                    String   @id @default(uuid())
  materialId            String   @map("material_id")
  quantityLinearMeters  Decimal  @map("quantity_lm") @db.Decimal(14, 3)
  totalCostMdl          Int      @map("total_cost_mdl")
  purchasedAt           DateTime @map("purchased_at") @db.Date
  supplier              String?  @db.Text
  note                  String?  @db.Text
  createdById           String?  @map("created_by_id")
  createdAt             DateTime @default(now()) @map("created_at")
  /// Set when the receipt was posted from an incoming e-Factura line.
  purchaseInvoiceLineId String?  @unique @map("purchase_invoice_line_id")
  /// Provisional receipt: priced at the last known unit cost until the supplier invoice arrives.
  isProvisional         Boolean  @default(false) @map("is_provisional")
  /// Legacy receipts were entered VAT-inclusive; new ones follow `AccountingSettings.purchaseCostsIncludeVat`.
  amountsIncludeVat     Boolean  @default(true) @map("amounts_include_vat")

  material            LargeFormatMaterial  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  purchaseInvoiceLine PurchaseInvoiceLine? @relation(fields: [purchaseInvoiceLineId], references: [id], onDelete: SetNull)
  createdBy           User?                @relation("lfRollReceiptsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([materialId, purchasedAt(sort: Desc)])
  @@map("lf_roll_stock_receipts")
}

model LfRollStockMovement {
  id                   String   @id @default(uuid())
  materialId           String   @map("material_id")
  quantityLinearMeters Decimal  @map("quantity_lm") @db.Decimal(14, 4)
  kind                 String   @map("kind")
  orderId              String?  @map("order_id")
  orderNumber          Int?     @map("order_number")
  orderLineId          String?  @map("order_line_id")
  materialCostMdl      Int?     @map("material_cost_mdl")
  materialSellPriceMdl Int?     @map("material_sell_price_mdl")
  note                 String?  @db.Text
  createdById          String?  @map("created_by_id")
  createdAt            DateTime @default(now()) @map("created_at")

  material  LargeFormatMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  order     Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderLine OrderLine?          @relation(fields: [orderLineId], references: [id], onDelete: SetNull)
  createdBy User?               @relation("lfRollStockMovementsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([materialId, createdAt(sort: Desc)])
  @@index([orderId])
  @@map("lf_roll_stock_movements")
}

/// Sheet paper catalog + weighted-average stock, counted in sheets.
/// Used by business cards and flyers (A4+ 22.5 × 32 imposition).
model SheetPaper {
  id                      String                    @id @default(uuid())
  /// Unified stock variant holding this paper's balance and cost (prices stay here).
  stockVariantId          String?                   @unique @map("stock_variant_id")
  name                    String
  /// Paper weight (g/m²), e.g. 105 … 350; null for papers added before it was tracked.
  gsm                     Int?
  sheetWidthCm            Decimal                   @map("sheet_width_cm") @db.Decimal(8, 2)
  sheetHeightCm           Decimal                   @map("sheet_height_cm") @db.Decimal(8, 2)
  /// Current stock balance (sheets).
  stockSheets             Decimal                   @default(0) @map("stock_sheets") @db.Decimal(14, 2)
  /// Weighted-average purchase cost (MDL per sheet). Null until first receipt; COGS falls back to `costPerSheet`.
  avgPurchaseCostPerSheet Decimal?                  @map("avg_purchase_cost_per_sheet") @db.Decimal(14, 4)
  /// Catalog purchase hint (MDL per sheet); used when `avgPurchaseCostPerSheet` is null.
  costPerSheet            Int                       @map("cost_per_sheet")
  /// Sell rate per printed sheet side (MDL, retail).
  retailPricePerSheet     Int                       @map("retail_price_per_sheet")
  /// Sell rate per printed sheet side (MDL, dealer).
  dealerPricePerSheet     Int                       @map("dealer_price_per_sheet")
  isActive                Boolean                   @default(true) @map("is_active")
  sortOrder               Int                       @default(0) @map("sort_order")
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")
  orderLines              OrderLine[]
  receipts                SheetPaperStockReceipt[]
  stockMovements          SheetPaperStockMovement[]
  stockVariant            StockVariant?             @relation("sheetPaperStock", fields: [stockVariantId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([sortOrder])
  @@map("sheet_papers")
}

/// Purchase receipt for sheet paper stock (weighted-average basis).
model SheetPaperStockReceipt {
  id                    String   @id @default(uuid())
  sheetPaperId          String   @map("sheet_paper_id")
  quantitySheets        Decimal  @map("quantity_sheets") @db.Decimal(14, 2)
  totalCostMdl          Int      @map("total_cost_mdl")
  purchasedAt           DateTime @map("purchased_at") @db.Date
  supplier              String?  @db.Text
  note                  String?  @db.Text
  createdById           String?  @map("created_by_id")
  createdAt             DateTime @default(now()) @map("created_at")
  /// Set when the receipt was posted from an incoming e-Factura line.
  purchaseInvoiceLineId String?  @unique @map("purchase_invoice_line_id")
  /// Provisional receipt: priced at the last known unit cost until the supplier invoice arrives.
  isProvisional         Boolean  @default(false) @map("is_provisional")
  /// Legacy receipts were entered VAT-inclusive; new ones follow `AccountingSettings.purchaseCostsIncludeVat`.
  amountsIncludeVat     Boolean  @default(true) @map("amounts_include_vat")

  sheetPaper          SheetPaper           @relation(fields: [sheetPaperId], references: [id], onDelete: Cascade)
  purchaseInvoiceLine PurchaseInvoiceLine? @relation(fields: [purchaseInvoiceLineId], references: [id], onDelete: SetNull)
  createdBy           User?                @relation("sheetPaperReceiptsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([sheetPaperId, purchasedAt(sort: Desc)])
  @@map("sheet_paper_stock_receipts")
}

model SheetPaperStockMovement {
  id                String   @id @default(uuid())
  sheetPaperId      String   @map("sheet_paper_id")
  quantitySheets    Decimal  @map("quantity_sheets") @db.Decimal(14, 2)
  kind              String   @map("kind")
  orderId           String?  @map("order_id")
  orderNumber       Int?     @map("order_number")
  orderLineId       String?  @map("order_line_id")
  paperCostMdl      Int?     @map("paper_cost_mdl")
  paperSellPriceMdl Int?     @map("paper_sell_price_mdl")
  note              String?  @db.Text
  createdById       String?  @map("created_by_id")
  createdAt         DateTime @default(now()) @map("created_at")

  sheetPaper SheetPaper @relation(fields: [sheetPaperId], references: [id], onDelete: Cascade)
  order      Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderLine  OrderLine? @relation(fields: [orderLineId], references: [id], onDelete: SetNull)
  createdBy  User?      @relation("sheetPaperStockMovementsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([sheetPaperId, createdAt(sort: Desc)])
  @@index([orderId])
  @@map("sheet_paper_stock_movements")
}

/// One ink balance per print process (e.g. LF roll eco-solvent vs UV vs DTF). PK id matches PrintProcess code.
model InkInventory {
  id           String   @id
  stockMl      Decimal  @default(0) @map("stock_ml") @db.Decimal(16, 3)
  avgCostPerMl Decimal  @default(0) @map("avg_cost_per_ml_mdl") @db.Decimal(16, 8)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  receipts  InkStockReceipt[]
  movements InkStockMovement[]

  @@map("ink_inventory")
}

model InkStockReceipt {
  id                    String   @id @default(uuid())
  inkInventoryId        String   @map("ink_inventory_id")
  quantityMl            Decimal  @map("quantity_ml") @db.Decimal(16, 3)
  totalCostMdl          Int      @map("total_cost_mdl")
  purchasedAt           DateTime @map("purchased_at") @db.Date
  note                  String?  @db.Text
  createdById           String?  @map("created_by_id")
  createdAt             DateTime @default(now()) @map("created_at")
  /// Set when the receipt was posted from an incoming e-Factura line.
  purchaseInvoiceLineId String?  @unique @map("purchase_invoice_line_id")
  /// Provisional receipt: priced at the last known unit cost until the supplier invoice arrives.
  isProvisional         Boolean  @default(false) @map("is_provisional")
  /// Legacy receipts were entered VAT-inclusive; new ones follow `AccountingSettings.purchaseCostsIncludeVat`.
  amountsIncludeVat     Boolean  @default(true) @map("amounts_include_vat")

  inkInventory        InkInventory         @relation(fields: [inkInventoryId], references: [id], onDelete: Restrict)
  purchaseInvoiceLine PurchaseInvoiceLine? @relation(fields: [purchaseInvoiceLineId], references: [id], onDelete: SetNull)
  createdBy           User?                @relation("inkReceiptsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([inkInventoryId, purchasedAt(sort: Desc)])
  @@map("ink_stock_receipts")
}

model InkStockMovement {
  id              String   @id @default(uuid())
  inkInventoryId  String   @map("ink_inventory_id")
  quantityMl      Decimal  @map("quantity_ml") @db.Decimal(16, 3)
  kind            String   @map("kind")
  orderId         String?  @map("order_id")
  orderNumber     Int?     @map("order_number")
  orderLineId     String?  @map("order_line_id")
  inkCostMdl      Int?     @map("ink_cost_mdl")
  inkSellPriceMdl Int?     @map("ink_sell_price_mdl")
  note            String?  @db.Text
  createdById     String?  @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")

  inkInventory InkInventory @relation(fields: [inkInventoryId], references: [id], onDelete: Restrict)
  order        Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderLine    OrderLine?   @relation(fields: [orderLineId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("inkStockMovementsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([inkInventoryId, createdAt(sort: Desc)])
  @@index([orderId])
  @@map("ink_stock_movements")
}

/// Garment model in one colour (e.g. «DOGO Premium T-shirt», black); stock lives per size in `GarmentVariant`.
model GarmentProduct {
  id            String           @id @default(uuid())
  /// tshirt | polo | bodysuit | socks | hoodie | other
  kind          String
  name          String
  colorName     String           @map("color_name")
  colorHex      String?          @map("color_hex")
  /// Per-piece price by run size, one print up to A4 included: `[{ minQty, priceMdl }]`; see `garmentPriceTiers.ts`.
  priceTiers    Json             @default("[]") @map("price_tiers")
  /// Purchase hint per piece (MDL); used for COGS while a size has no receipts yet.
  purchaseCost  Decimal?         @map("purchase_cost") @db.Decimal(12, 2)
  isActive      Boolean          @default(true) @map("is_active")
  sortOrder     Int              @default(0) @map("sort_order")
  internalNotes String?          @map("internal_notes")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  variants      GarmentVariant[]

  @@unique([name, colorName])
  @@index([isActive, sortOrder])
  @@map("garment_products")
}

/// One size of a garment with its own balance and weighted-average cost.
model GarmentVariant {
  id               String                 @id @default(uuid())
  garmentProductId String                 @map("garment_product_id")
  size             String
  sortOrder        Int                    @default(0) @map("sort_order")
  stockQuantity    Int                    @default(0) @map("stock_quantity")
  avgPurchaseCost  Decimal?               @map("avg_purchase_cost") @db.Decimal(14, 4)
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  garmentProduct   GarmentProduct         @relation(fields: [garmentProductId], references: [id], onDelete: Cascade)
  receipts         GarmentStockReceipt[]
  movements        GarmentStockMovement[]

  @@unique([garmentProductId, size])
  @@map("garment_variants")
}

model GarmentStockReceipt {
  id                    String   @id @default(uuid())
  garmentVariantId      String   @map("garment_variant_id")
  quantity              Int
  totalCostMdl          Decimal  @map("total_cost_mdl") @db.Decimal(14, 2)
  purchasedAt           DateTime @map("purchased_at") @db.Date
  supplier              String?  @db.Text
  note                  String?  @db.Text
  createdById           String?  @map("created_by_id")
  createdAt             DateTime @default(now()) @map("created_at")
  purchaseInvoiceLineId String?  @unique @map("purchase_invoice_line_id")
  isProvisional         Boolean  @default(false) @map("is_provisional")
  amountsIncludeVat     Boolean  @default(true) @map("amounts_include_vat")

  garmentVariant      GarmentVariant       @relation(fields: [garmentVariantId], references: [id], onDelete: Cascade)
  purchaseInvoiceLine PurchaseInvoiceLine? @relation(fields: [purchaseInvoiceLineId], references: [id], onDelete: SetNull)
  createdBy           User?                @relation("garmentReceiptsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([garmentVariantId, purchasedAt(sort: Desc)])
  @@map("garment_stock_receipts")
}

model GarmentStockMovement {
  id               String   @id @default(uuid())
  garmentVariantId String   @map("garment_variant_id")
  delta            Int
  /// See `GARMENT_STOCK_KIND`.
  kind             String
  orderId          String?  @map("order_id")
  orderNumber      Int?     @map("order_number")
  orderLineId      String?  @map("order_line_id")
  /// Receipt: purchase total; sale / return: quantity × weighted-average cost at that moment.
  costMdl          Decimal? @map("cost_mdl") @db.Decimal(14, 2)
  note             String?  @db.Text
  createdById      String?  @map("created_by_id")
  createdAt        DateTime @default(now()) @map("created_at")

  garmentVariant GarmentVariant @relation(fields: [garmentVariantId], references: [id], onDelete: Cascade)
  order          Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderLine      OrderLine?     @relation(fields: [orderLineId], references: [id], onDelete: SetNull)
  createdBy      User?          @relation("garmentStockMovementsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([garmentVariantId, createdAt(sort: Desc)])
  @@index([orderId])
  @@map("garment_stock_movements")
}

/// Bulk DTF consumables; PK id is a `DtfConsumable` code (dtf_film in linear m, dtf_powder in g).
model DtfConsumableStock {
  id             String                  @id
  stockQuantity  Decimal                 @default(0) @map("stock_quantity") @db.Decimal(16, 3)
  avgCostPerUnit Decimal                 @default(0) @map("avg_cost_per_unit_mdl") @db.Decimal(16, 8)
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  receipts       DtfConsumableReceipt[]
  movements      DtfConsumableMovement[]

  @@map("dtf_consumable_stock")
}

model DtfConsumableReceipt {
  id                    String   @id @default(uuid())
  consumableId          String   @map("consumable_id")
  quantity              Decimal  @db.Decimal(16, 3)
  totalCostMdl          Decimal  @map("total_cost_mdl") @db.Decimal(14, 2)
  purchasedAt           DateTime @map("purchased_at") @db.Date
  supplier              String?  @db.Text
  note                  String?  @db.Text
  createdById           String?  @map("created_by_id")
  createdAt             DateTime @default(now()) @map("created_at")
  purchaseInvoiceLineId String?  @unique @map("purchase_invoice_line_id")
  isProvisional         Boolean  @default(false) @map("is_provisional")
  amountsIncludeVat     Boolean  @default(true) @map("amounts_include_vat")

  consumable          DtfConsumableStock   @relation(fields: [consumableId], references: [id], onDelete: Restrict)
  purchaseInvoiceLine PurchaseInvoiceLine? @relation(fields: [purchaseInvoiceLineId], references: [id], onDelete: SetNull)
  createdBy           User?                @relation("dtfConsumableReceiptsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([consumableId, purchasedAt(sort: Desc)])
  @@map("dtf_consumable_receipts")
}

model DtfConsumableMovement {
  id           String   @id @default(uuid())
  consumableId String   @map("consumable_id")
  /// Signed: negative for order consumption, positive for receipts and returns.
  quantity     Decimal  @db.Decimal(16, 3)
  /// See `DTF_CONSUMABLE_KIND`.
  kind         String
  orderId      String?  @map("order_id")
  orderNumber  Int?     @map("order_number")
  orderLineId  String?  @map("order_line_id")
  costMdl      Decimal? @map("cost_mdl") @db.Decimal(14, 2)
  note         String?  @db.Text
  createdById  String?  @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  consumable DtfConsumableStock @relation(fields: [consumableId], references: [id], onDelete: Restrict)
  order      Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderLine  OrderLine?         @relation(fields: [orderLineId], references: [id], onDelete: SetNull)
  createdBy  User?              @relation("dtfConsumableMovementsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([consumableId, createdAt(sort: Desc)])
  @@index([orderId])
  @@map("dtf_consumable_movements")
}

/// DTF price list entry: transfer size class with per-piece print price.
model DtfPrintPreset {
  id          String   @id @default(uuid())
  label       String
  widthCm     Decimal  @map("width_cm") @db.Decimal(6, 2)
  heightCm    Decimal  @map("height_cm") @db.Decimal(6, 2)
  retailPrice Decimal  @map("retail_price") @db.Decimal(12, 2)
  dealerPrice Decimal? @map("dealer_price") @db.Decimal(12, 2)
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("dtf_print_presets")
}

// Studio customer registry (table clients). Model name avoids prisma.client delegate ambiguity.
model StudioCustomer {
  id              String          @id @default(uuid())
  kind            String
  phone           String?
  phoneNormalized String?         @map("phone_normalized")
  personName      String?         @map("person_name")
  companyName     String?         @map("company_name")
  companyIdno     String?         @map("company_idno")
  email           String?
  isDealer        Boolean         @default(false) @map("is_dealer")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  orders          Order[]
  userAccount     User?
  invoices        Invoice[]
  fiscalInvoices  FiscalInvoice[] @relation("clientFiscalInvoices")

  @@index([phoneNormalized])
  @@map("clients")
}

/// One logical product within an order (paper job, mug line, notebook line).
/// Legacy orders have a single line backfilled from `Order` mug/notebook fields.
model OrderLine {
  id                       String                    @id @default(uuid())
  orderId                  String                    @map("order_id")
  sortOrder                Int                       @default(0) @map("sort_order")
  productType              String                    @map("product_type")
  mugLayoutData            Json?                     @map("mug_layout_data")
  mugProductId             String?                   @map("mug_product_id")
  mugProductSnapshot       Json?                     @map("mug_product_snapshot")
  notebookLayoutData       Json?                     @map("notebook_layout_data")
  notebookProductId        String?                   @map("notebook_product_id")
  notebookProductSnapshot  Json?                     @map("notebook_product_snapshot")
  penLayoutData            Json?                     @map("pen_layout_data")
  penProductId             String?                   @map("pen_product_id")
  penProductSnapshot       Json?                     @map("pen_product_snapshot")
  /// Unified stock variant the line is made from (pens now; mugs, notebooks… in later stages).
  stockVariantId           String?                   @map("stock_variant_id")
  largeFormatMaterialId    String?                   @map("large_format_material_id")
  largeFormatLineData      Json?                     @map("large_format_line_data")
  sheetPaperId             String?                   @map("sheet_paper_id")
  /// Sheet-product snapshot (business cards and flyers share the shape).
  businessCardLineData     Json?                     @map("business_card_line_data")
  /// DTF-on-garment snapshot: garment, sizes, print zones, pricing, consumption.
  dtfLineData              Json?                     @map("dtf_line_data")
  /// UV print on our stock item or a client's item (docs/PRINT-METHODS-PLAN.md, stage C); see `src/lib/uv/types.ts`.
  uvLineData               Json?                     @map("uv_line_data")
  /// Set when the line's layout came from a Design Studio design.
  designId                 String?                   @map("design_id")
  order                    Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  mugProduct               MugProduct?               @relation(fields: [mugProductId], references: [id], onDelete: SetNull)
  notebookProduct          NotebookProduct?          @relation(fields: [notebookProductId], references: [id], onDelete: SetNull)
  penProduct               PenProduct?               @relation(fields: [penProductId], references: [id], onDelete: SetNull)
  stockVariant             StockVariant?             @relation(fields: [stockVariantId], references: [id], onDelete: Restrict)
  largeFormatMaterial      LargeFormatMaterial?      @relation(fields: [largeFormatMaterialId], references: [id], onDelete: SetNull)
  sheetPaper               SheetPaper?               @relation(fields: [sheetPaperId], references: [id], onDelete: SetNull)
  design                   Design?                   @relation(fields: [designId], references: [id], onDelete: SetNull)
  files                    File[]
  inkStockMovements        InkStockMovement[]
  lfRollStockMovements     LfRollStockMovement[]
  sheetPaperStockMovements SheetPaperStockMovement[]
  garmentStockMovements    GarmentStockMovement[]
  dtfConsumableMovements   DtfConsumableMovement[]

  @@index([orderId, sortOrder])
  @@index([mugProductId])
  @@index([notebookProductId])
  @@index([penProductId])
  @@index([stockVariantId])
  @@index([largeFormatMaterialId])
  @@index([sheetPaperId])
  @@index([designId])
  @@map("order_lines")
}

/// Design Studio: a freeform design document (Canva-style canvas) with
/// draft/ready lifecycle. Geometry is bound either to a catalog product's
/// print area (mug/notebook) or to a custom cm size at `dpi`.
model Design {
  id                String           @id @default(uuid())
  title             String
  /// draft | ready | archived
  status            String           @default("draft")
  /// mug | notebook | custom
  targetType        String           @map("target_type")
  mugProductId      String?          @map("mug_product_id")
  notebookProductId String?          @map("notebook_product_id")
  /// Unified stock variant the design is made for (mugs, notebooks…); replaces the legacy product ids.
  stockVariantId    String?          @map("stock_variant_id")
  widthCm           Decimal          @map("width_cm") @db.Decimal(6, 2)
  heightCm          Decimal          @map("height_cm") @db.Decimal(6, 2)
  dpi               Int              @default(300)
  canvasWidthPx     Int              @map("canvas_width_px")
  canvasHeightPx    Int              @map("canvas_height_px")
  /// DesignDoc JSON — see `src/lib/design/doc.ts`.
  doc               Json
  docVersion        Int              @default(1) @map("doc_version")
  /// Print-resolution PNG in the uploads bucket, refreshed on save.
  renderKey         String?          @map("render_key")
  /// Small preview PNG for the library grid.
  thumbKey          String?          @map("thumb_key")
  renderedAt        DateTime?        @map("rendered_at")
  tags              String[]         @default([])
  isTemplate        Boolean          @default(false) @map("is_template")
  createdBy         String?          @map("created_by")
  updatedBy         String?          @map("updated_by")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  deletedAt         DateTime?        @map("deleted_at")
  mugProduct        MugProduct?      @relation(fields: [mugProductId], references: [id], onDelete: SetNull)
  notebookProduct   NotebookProduct? @relation(fields: [notebookProductId], references: [id], onDelete: SetNull)
  stockVariant      StockVariant?    @relation(fields: [stockVariantId], references: [id], onDelete: SetNull)
  orderLines        OrderLine[]

  @@index([status, updatedAt(sort: Desc)])
  @@index([isTemplate])
  @@index([stockVariantId])
  @@map("designs")
}

/// Design Studio: shared clipart library (PNG illustrations with alpha),
/// stored in the public catalog bucket under `catalog/design-assets/`.
model DesignAsset {
  id        String    @id @default(uuid())
  name      String
  category  String?
  tags      String[]  @default([])
  fileKey   String    @map("file_key")
  thumbKey  String?   @map("thumb_key")
  widthPx   Int       @map("width_px")
  heightPx  Int       @map("height_px")
  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([category])
  @@map("design_assets")
}

model File {
  id          String    @id @default(uuid())
  orderId     String    @map("order_id")
  orderLineId String    @map("order_line_id")
  fileUrl     String    @map("file_url")
  fileName    String    @map("file_name")
  copies      Int       @default(1)
  color       String    @default("bw")
  paperType   String?   @map("paper_type")
  pageCount   Int?      @map("page_count")
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderLine   OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)

  @@index([orderLineId])
  @@map("files")
}

model User {
  id                              String                    @id @default(uuid())
  name                            String
  displayName                     String?                   @map("display_name")
  role                            String                    @default("admin")
  password                        String
  // Customer-portal users (role = "customer") link 1:1 to a StudioCustomer.
  // Staff (admin/superadmin/workshop) leave this null.
  studioCustomerId                String?                   @unique @map("studio_customer_id")
  // Denormalized normalized phone for fast customer login lookups without a join.
  phoneNormalized                 String?                   @unique @map("phone_normalized")
  sessions                        Session[]
  comments                        Comment[]
  clientMessages                  ClientMessage[]
  createdOrders                   Order[]                   @relation("createdOrders")
  sentToWorkshopOrders            Order[]                   @relation("sentToWorkshopOrders")
  mugProductsCreated              MugProduct[]              @relation("mugProductsCreated")
  mugStockMovementsCreated        MugStockMovement[]        @relation("mugStockCreatedBy")
  notebookProductsCreated         NotebookProduct[]         @relation("notebookProductsCreated")
  notebookStockMovementsCreated   NotebookStockMovement[]   @relation("notebookStockCreatedBy")
  penProductsCreated              PenProduct[]              @relation("penProductsCreated")
  penStockMovementsCreated        PenStockMovement[]        @relation("penStockCreatedBy")
  mugReceiptsCreated              MugStockReceipt[]         @relation("mugReceiptsCreated")
  notebookReceiptsCreated         NotebookStockReceipt[]    @relation("notebookReceiptsCreated")
  penReceiptsCreated              PenStockReceipt[]         @relation("penReceiptsCreated")
  purchaseLinesPosted             PurchaseInvoiceLine[]     @relation("purchaseLinesPosted")
  invoicesCreated                 Invoice[]                 @relation("invoicesCreated")
  lfRollReceiptsCreated           LfRollStockReceipt[]      @relation("lfRollReceiptsCreated")
  inkReceiptsCreated              InkStockReceipt[]         @relation("inkReceiptsCreated")
  inkStockMovementsCreated        InkStockMovement[]        @relation("inkStockMovementsCreated")
  lfRollStockMovementsCreated     LfRollStockMovement[]     @relation("lfRollStockMovementsCreated")
  sheetPaperReceiptsCreated       SheetPaperStockReceipt[]  @relation("sheetPaperReceiptsCreated")
  sheetPaperStockMovementsCreated SheetPaperStockMovement[] @relation("sheetPaperStockMovementsCreated")
  garmentReceiptsCreated          GarmentStockReceipt[]     @relation("garmentReceiptsCreated")
  garmentStockMovementsCreated    GarmentStockMovement[]    @relation("garmentStockMovementsCreated")
  dtfConsumableReceiptsCreated    DtfConsumableReceipt[]    @relation("dtfConsumableReceiptsCreated")
  dtfConsumableMovementsCreated   DtfConsumableMovement[]   @relation("dtfConsumableMovementsCreated")
  bankStatementsUploaded          BankStatement[]           @relation("bankStatementsUploaded")
  paymentAllocationsMatched       PaymentAllocation[]       @relation("paymentAllocationsMatched")
  workshopBatchesCreated          WorkshopBatchLayout[]     @relation("workshopBatchesCreated")
  studioCustomer                  StudioCustomer?           @relation(fields: [studioCustomerId], references: [id], onDelete: SetNull)
  stockReceiptsCreated            StockReceipt[]            @relation("stockReceiptsCreated")
  stockMovementsCreated           StockMovement[]           @relation("stockMovementsCreated")

  @@map("users")
}

/// Persisted history of workshop-batch layouts generated by the pen / notebook
/// side-by-side composer tools (see `src/app/admin/(protected)/workshop-batches`).
/// The PNG blob lives in the main `uploads` bucket under the
/// `uploads/workshop-batches/…` prefix so the same 7-day R2 lifecycle rule as
/// order-file uploads reaps it. `deletedAt` gives workshop operators a soft
/// "hide from list" toggle without racing the object storage sweeper.
model WorkshopBatchLayout {
  id          String    @id @default(uuid())
  /// "notebook" | "pen" | "freepack" | "mug"
  kind        String
  /// Object storage key (e.g. `uploads/workshop-batches/1738…-abcd1234-batch.png`).
  fileKey     String    @map("file_key")
  fileName    String    @map("file_name")
  contentType String    @default("image/png") @map("content_type")
  sizeBytes   Int       @map("size_bytes")
  tileCount   Int       @map("tile_count")
  createdById String?   @map("created_by_id")
  createdBy   User?     @relation("workshopBatchesCreated", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([kind, createdAt(sort: Desc)])
  @@index([deletedAt])
  @@map("workshop_batch_layouts")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Comment {
  id        String    @id @default(uuid())
  orderId   String    @map("order_id")
  userId    String    @map("user_id")
  text      String
  createdAt DateTime  @default(now()) @map("created_at")
  /// Set whenever a user updates `text` after creation. Drives the
  /// "(edited)" badge in the comment panel; `null` means the message
  /// has been displayed exactly as posted.
  editedAt  DateTime? @map("edited_at")
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@index([orderId, createdAt(sort: Desc)])
  @@map("comments")
}

model CommentRead {
  id      String   @id @default(uuid())
  orderId String   @map("order_id")
  userId  String   @map("user_id")
  readAt  DateTime @default(now()) @map("read_at")
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, userId])
  @@map("comment_reads")
}

/// Two-way conversation between studio staff and the order's client, kept
/// fully separate from the staff-internal `Comment` thread. `userId` may be a
/// staff user OR a customer-portal user — both are rows in `User`.
model ClientMessage {
  id        String    @id @default(uuid())
  orderId   String    @map("order_id")
  userId    String    @map("user_id")
  text      String
  createdAt DateTime  @default(now()) @map("created_at")
  editedAt  DateTime? @map("edited_at")
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@index([orderId, createdAt(sort: Desc)])
  @@map("client_messages")
}

/// Per-user "read up to" watermark for the client-message channel.
model ClientMessageRead {
  id      String   @id @default(uuid())
  orderId String   @map("order_id")
  userId  String   @map("user_id")
  readAt  DateTime @default(now()) @map("read_at")
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, userId])
  @@map("client_message_reads")
}

model OrderLog {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  userId    String   @map("user_id")
  action    String
  field     String?
  oldValue  String?  @map("old_value")
  newValue  String?  @map("new_value")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_logs")
}

// Singleton supplier profile for invoices ("Cont spre plata"). Editable by superadmin.
// One row in production; the row holds the atomic counter for invoice numbering.
model CompanyProfile {
  id                        String    @id @default(uuid())
  name                      String
  fiscalCode                String    @map("fiscal_code")
  address                   String
  iban                      String
  bankName                  String    @map("bank_name")
  bic                       String
  directorName              String?   @map("director_name")
  accountantName            String?   @map("accountant_name")
  // Stored as Decimal for forward compatibility (per-supplier rate). V1 always uses 20%.
  vatRate                   Decimal   @default(20) @map("vat_rate") @db.Decimal(5, 2)
  // Atomic invoice counter (incremented on ISSUE).
  invoiceCounter            Int       @default(0) @map("invoice_counter")
  invoiceNumberPadding      Int       @default(4) @map("invoice_number_padding")
  invoiceValidityDays       Int       @default(5) @map("invoice_validity_days")
  defaultLocale             String    @default("ro") @map("default_locale")
  currency                  String    @default("MDL")
  logoPath                  String?   @map("logo_path")
  // Superadmin: show cabinet-login CTA on /, /mug, /notebook.
  showPublicCabinetLoginCta Boolean   @default(true) @map("show_public_cabinet_login_cta")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")
  invoices                  Invoice[]

  @@map("company_profiles")
}

// Header of "Cont spre plata" invoice. DRAFT is editable; on ISSUE we freeze
// snapshots, assign sequenceNumber/number from CompanyProfile counter, set validUntil.
model Invoice {
  id               String    @id @default(uuid())
  // Rendered number (e.g. "0306"). Null for DRAFT until ISSUE.
  number           String?   @unique
  // Raw integer from CompanyProfile.invoiceCounter at ISSUE time.
  sequenceNumber   Int?      @unique @map("sequence_number")
  companyProfileId String    @map("company_profile_id")
  clientId         String    @map("client_id")
  issueDate        DateTime  @map("issue_date")
  validUntil       DateTime  @map("valid_until")
  // Locale used to render the PDF; defaults to admin UI language at creation.
  locale           String    @default("ro")
  currency         String    @default("MDL")
  // DRAFT | ISSUED | PAID | CANCELLED
  status           String    @default("DRAFT")
  // Frozen at ISSUE time (currently always 20).
  vatRate          Decimal   @map("vat_rate") @db.Decimal(5, 2)
  // V1 always inclusive (line prices contain VAT).
  vatInclusive     Boolean   @default(true) @map("vat_inclusive")
  subtotal         Decimal   @default(0) @db.Decimal(12, 2)
  vatAmount        Decimal   @default(0) @map("vat_amount") @db.Decimal(12, 2)
  totalAmount      Decimal   @default(0) @map("total_amount") @db.Decimal(12, 2)
  notes            String?
  paidAt           DateTime? @map("paid_at")
  paidNote         String?   @map("paid_note")
  cancelledAt      DateTime? @map("cancelled_at")
  cancelReason     String?   @map("cancel_reason")
  // Frozen at ISSUE — supplier+client legal info captured at the time of issuing
  // so retroactive registry edits do not change a previously issued document.
  supplierSnapshot Json?     @map("supplier_snapshot")
  clientSnapshot   Json?     @map("client_snapshot")
  createdById      String?   @map("created_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  companyProfile CompanyProfile      @relation(fields: [companyProfileId], references: [id])
  client         StudioCustomer      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy      User?               @relation("invoicesCreated", fields: [createdById], references: [id], onDelete: SetNull)
  lineItems      InvoiceLineItem[]
  allocations    PaymentAllocation[]
  fiscalInvoices FiscalInvoice[]     @relation("invoiceFiscalDocs")

  @@index([clientId])
  @@index([status])
  @@index([issueDate])
  @@map("invoices")
}

model InvoiceLineItem {
  id          String  @id @default(uuid())
  invoiceId   String  @map("invoice_id")
  position    Int     @default(0)
  description String
  unit        String  @default("buc")
  quantity    Decimal @db.Decimal(10, 3)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  lineTotal   Decimal @map("line_total") @db.Decimal(12, 2)
  vatAmount   Decimal @map("vat_amount") @db.Decimal(12, 2)
  // Optional bidirectional link to a printing order. Lines created from an
  // existing order set this; lines that spawn a new order via the wizard
  // get this populated by the order-create transaction.
  orderId     String? @map("order_id")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  order   Order?  @relation("orderInvoiceLines", fields: [orderId], references: [id], onDelete: SetNull)

  @@index([invoiceId, position])
  @@index([orderId])
  @@map("invoice_line_items")
}

/// Singleton row (id = "default") — estimated production costs per unit / per order.
model AccountingSettings {
  id                      String    @id @default("default")
  productionCosts         Json      @default("{}") @map("production_costs")
  /// Basis for purchase costs (receipts, weighted averages). True until the ex-VAT cutover is applied.
  purchaseCostsIncludeVat Boolean   @default(true) @map("purchase_costs_include_vat")
  /// When the ex-VAT cutover tool was applied (null = never).
  vatCutoverAt            DateTime? @map("vat_cutover_at")
  /// DTF production norms and fees (film width, gap, powder, pressing); see `src/lib/dtf/dtfSettings.ts`.
  dtfSettings             Json      @default("{}") @map("dtf_settings")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  @@map("accounting_settings")
}

model BusinessExpense {
  id        String    @id @default(uuid())
  name      String
  /// rent | tax | equipment_depreciation | consumables | electricity | other
  type      String    @map("type")
  /// Amount in the given period (MDL whole units).
  amount    Int       @map("amount")
  /// daily | monthly | yearly | one_time
  period    String    @map("period")
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  isActive  Boolean   @default(true) @map("is_active")
  notes     String?   @map("notes")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([startDate])
  @@map("business_expenses")
}

/// Uploaded bank statement file (one row per uploaded document). V1 format is
/// MAIB "current account statement" CSV. The parsed rows live in BankTransaction.
model BankStatement {
  id             String    @id @default(uuid())
  fileName       String    @map("file_name")
  /// Parser id used to read the file. V1: "maib_csv".
  format         String    @default("maib_csv")
  accountIban    String?   @map("account_iban")
  /// Opening balance ("sold initial") captured from the statement header row.
  openingBalance Decimal?  @map("opening_balance") @db.Decimal(14, 2)
  periodFrom     DateTime? @map("period_from")
  periodTo       DateTime? @map("period_to")
  currency       String    @default("MDL")
  /// R2/S3 object key of the original uploaded file (audit / re-parse).
  storageKey     String?   @map("storage_key")
  /// PARSED | ERROR
  status         String    @default("PARSED")
  rowCount       Int       @default(0) @map("row_count")
  /// Per-row parse warnings/errors { line, message }[] that did not abort import.
  errorReport    Json?     @map("error_report")
  uploadedById   String?   @map("uploaded_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  uploadedBy   User?             @relation("bankStatementsUploaded", fields: [uploadedById], references: [id], onDelete: SetNull)
  transactions BankTransaction[]

  @@index([createdAt])
  @@map("bank_statements")
}

/// One normalized transaction parsed from a bank statement.
model BankTransaction {
  id                 String    @id @default(uuid())
  statementId        String    @map("statement_id")
  bookingDate        DateTime  @map("booking_date")
  valueDate          DateTime? @map("value_date")
  /// CREDIT (incoming, DC=1) | DEBIT (outgoing, DC=0)
  direction          String
  amount             Decimal   @db.Decimal(14, 2)
  currency           String    @default("MDL")
  counterpartyName   String?   @map("counterparty_name")
  counterpartyIdno   String?   @map("counterparty_idno")
  counterpartyIban   String?   @map("counterparty_iban")
  /// Full payment purpose (DE1..DE4 concatenated).
  purpose            String?
  documentNumber     String?   @map("document_number")
  bankRef            String?   @map("bank_ref")
  /// Bank transaction type code (MAIB "TD": 1 = client transfer, 6 = internal/commission).
  txTypeCode         String?   @map("tx_type_code")
  /// UNMATCHED | SUGGESTED | MATCHED | IGNORED | HISTORICAL | ACT_SETTLED
  matchStatus        String    @default("UNMATCHED") @map("match_status")
  /// Label for a pre-e-Factura / paper invoice when matchStatus = HISTORICAL.
  historicalDocument String?   @map("historical_document")
  /// Fingerprint for idempotent re-import across statements.
  dedupeKey          String    @unique @map("dedupe_key")
  createdAt          DateTime  @default(now()) @map("created_at")

  statement   BankStatement       @relation(fields: [statementId], references: [id], onDelete: Cascade)
  allocations PaymentAllocation[]

  @@index([statementId])
  @@index([matchStatus])
  @@index([bookingDate])
  @@index([counterpartyIdno])
  @@map("bank_transactions")
}

/// Reconciliation link between a bank transaction (payment) and a receivable.
/// The receivable is primarily a FiscalInvoice (e-Factura document); a Cont
/// spre plata (Invoice) link is optional/secondary. Exactly one target is set
/// (enforced in application code). Supports partial and multi-target splits.
model PaymentAllocation {
  id                String   @id @default(uuid())
  bankTransactionId String   @map("bank_transaction_id")
  /// Primary receivable target (e-Factura fiscal invoice).
  fiscalInvoiceId   String?  @map("fiscal_invoice_id")
  /// Optional secondary target (internal Cont spre plata).
  invoiceId         String?  @map("invoice_id")
  amount            Decimal  @db.Decimal(14, 2)
  /// AUTO | MANUAL
  matchedBy         String   @default("MANUAL") @map("matched_by")
  /// 0..100 auto-match confidence (null for manual).
  confidence        Int?
  matchedById       String?  @map("matched_by_id")
  note              String?
  createdAt         DateTime @default(now()) @map("created_at")

  bankTransaction BankTransaction @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade)
  fiscalInvoice   FiscalInvoice?  @relation(fields: [fiscalInvoiceId], references: [id], onDelete: Cascade)
  invoice         Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  matchedByUser   User?           @relation("paymentAllocationsMatched", fields: [matchedById], references: [id], onDelete: SetNull)

  @@unique([bankTransactionId, fiscalInvoiceId])
  @@unique([bankTransactionId, invoiceId])
  @@index([fiscalInvoiceId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

/// Fiscal invoice (factura fiscala) mirrored from Moldovan e-Factura (SFS).
/// Kept as a separate document from Invoice (Cont spre plata); optionally linked
/// to our Invoice and/or client once matched.
model FiscalInvoice {
  id               String    @id @default(uuid())
  seria            String
  number           String
  /// e-Factura status: 0 Draft, 1 Signed(Supplier), 2 Rejected(Buyer),
  /// 3 Accepted(Buyer), 5 Cancelled(Supplier), 7 Sent, 8 Signed(Buyer), 10 Transported.
  eFacturaStatus   Int       @map("efactura_status")
  issueDate        DateTime? @map("issue_date")
  totalAmount      Decimal?  @map("total_amount") @db.Decimal(14, 2)
  vatAmount        Decimal?  @map("vat_amount") @db.Decimal(14, 2)
  currency         String    @default("MDL")
  buyerName        String?   @map("buyer_name")
  buyerIdno        String?   @map("buyer_idno")
  buyerSnapshot    Json?     @map("buyer_snapshot")
  /// Raw payload from e-Factura for audit / future fields.
  rawPayload       Json?     @map("raw_payload")
  invoiceId        String?   @map("invoice_id")
  clientId         String?   @map("client_id")
  /// Set once bank payments fully cover this fiscal invoice.
  paidAt           DateTime? @map("paid_at")
  /// "Путевой лист" reference from the invoice XML, e.g.
  /// "B/f 0013 din data 09.07.2026 (card)". When it is a fiscal receipt the
  /// invoice was collected at the POS terminal (no bank transfer to match).
  receiptRef       String?   @map("receipt_ref")
  /// Payment method inferred from the receipt reference: "card" | "cash".
  receiptMethod    String?   @map("receipt_method")
  /// Set when the invoice was settled by a fiscal receipt (B/f).
  receiptSettledAt DateTime? @map("receipt_settled_at")
  /// R2/local object key for a photo of the POS / cash receipt (manual settle).
  receiptPhotoKey  String?   @map("receipt_photo_key")
  /// Set once the full invoice XML has been pulled (idempotency marker so the
  /// enrichment batch does not re-fetch already-loaded invoices).
  detailsFetchedAt DateTime? @map("details_fetched_at")
  /// e-Factura `<Redirections>` / creation reason, e.g. "Non-livrare".
  /// Non-delivery invoices are excluded from receivables reconciliation.
  redirections     String?   @map("redirections")
  lastSyncedAt     DateTime  @default(now()) @map("last_synced_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  invoice     Invoice?            @relation("invoiceFiscalDocs", fields: [invoiceId], references: [id], onDelete: SetNull)
  client      StudioCustomer?     @relation("clientFiscalInvoices", fields: [clientId], references: [id], onDelete: SetNull)
  allocations PaymentAllocation[]

  @@unique([seria, number])
  @@index([eFacturaStatus])
  @@index([buyerIdno])
  @@index([issueDate])
  @@index([invoiceId])
  @@index([clientId])
  @@index([paidAt])
  @@index([detailsFetchedAt])
  @@index([redirections])
  @@index([receiptSettledAt])
  @@map("fiscal_invoices")
}

/// Counterparties that are operational / not real clients (bank acquiring,
/// terminal settlements, owner deposits). Excluded from debtor/creditor
/// reconciliation and shown separately.
model ReconciliationExclusion {
  id          String   @id @default(uuid())
  idno        String   @unique
  name        String?
  note        String?
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("reconciliation_exclusions")
}

/// Incoming fiscal invoice from e-Factura where ANVI is the buyer (supplier purchases).
/// Kept apart from `FiscalInvoice` (our receivables) so reconciliation is unaffected.
model PurchaseInvoice {
  id               String    @id @default(uuid())
  seria            String
  number           String
  eFacturaStatus   Int       @map("efactura_status")
  supplierIdno     String?   @map("supplier_idno")
  supplierName     String?   @map("supplier_name")
  issueDate        DateTime? @map("issue_date")
  deliveryDate     DateTime? @map("delivery_date")
  totalExVat       Decimal?  @map("total_ex_vat") @db.Decimal(14, 2)
  vatAmount        Decimal?  @map("vat_amount") @db.Decimal(14, 2)
  totalAmount      Decimal?  @map("total_amount") @db.Decimal(14, 2)
  /// new | needs_review | partially_posted | posted | ignored
  status           String    @default("new")
  rawXml           String?   @map("raw_xml") @db.Text
  detailsFetchedAt DateTime? @map("details_fetched_at")
  lastSyncedAt     DateTime  @default(now()) @map("last_synced_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  lines PurchaseInvoiceLine[]

  @@unique([seria, number])
  @@index([status])
  @@index([supplierIdno])
  @@index([issueDate])
  @@map("purchase_invoices")
}

model PurchaseInvoiceLine {
  id             String    @id @default(uuid())
  invoiceId      String    @map("invoice_id")
  position       Int
  name           String
  normalizedName String    @map("normalized_name")
  unit           String?
  quantity       Decimal   @db.Decimal(14, 3)
  unitPriceExVat Decimal?  @map("unit_price_ex_vat") @db.Decimal(14, 4)
  totalExVat     Decimal   @map("total_ex_vat") @db.Decimal(14, 2)
  vatRate        Decimal?  @map("vat_rate") @db.Decimal(5, 2)
  vatAmount      Decimal?  @map("vat_amount") @db.Decimal(14, 2)
  total          Decimal   @db.Decimal(14, 2)
  /// unmatched | suggested | posted | ignored
  status         String    @default("unmatched")
  mappingId      String?   @map("mapping_id")
  /// Target chosen at posting time (snapshot; the mapping may change later).
  postedKind     String?   @map("posted_kind")
  postedTargetId String?   @map("posted_target_id")
  postedQuantity Decimal?  @map("posted_quantity") @db.Decimal(14, 3)
  postedCostMdl  Decimal?  @map("posted_cost_mdl") @db.Decimal(14, 2)
  postedAt       DateTime? @map("posted_at")
  postedAuto     Boolean   @default(false) @map("posted_auto")
  postedById     String?   @map("posted_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  invoice              PurchaseInvoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  mapping              SupplierItemMapping?    @relation(fields: [mappingId], references: [id], onDelete: SetNull)
  postedBy             User?                   @relation("purchaseLinesPosted", fields: [postedById], references: [id], onDelete: SetNull)
  mugReceipt           MugStockReceipt?
  notebookReceipt      NotebookStockReceipt?
  penReceipt           PenStockReceipt?
  lfRollReceipt        LfRollStockReceipt?
  sheetPaperReceipt    SheetPaperStockReceipt?
  inkReceipt           InkStockReceipt?
  garmentReceipt       GarmentStockReceipt?
  dtfConsumableReceipt DtfConsumableReceipt?
  stockReceipt         StockReceipt?

  @@unique([invoiceId, position])
  @@index([status])
  @@map("purchase_invoice_lines")
}

/// Learned link: a supplier's invoice line name → one of our stock items.
model SupplierItemMapping {
  id                  String    @id @default(uuid())
  supplierIdno        String    @map("supplier_idno")
  supplierName        String?   @map("supplier_name")
  normalizedName      String    @map("normalized_name")
  /// Last raw line name seen (for display).
  sampleName          String    @map("sample_name")
  /// mug | notebook | pen | lf_material | sheet_paper | ink | ignore
  targetKind          String    @map("target_kind")
  /// Stock item id (ink: print process code); null for `ignore`.
  targetId            String?   @map("target_id")
  /// Our stock units per one invoice unit (e.g. 1 roll «buc» = 30 linear m).
  unitsPerInvoiceUnit Decimal   @default(1) @map("units_per_invoice_unit") @db.Decimal(14, 4)
  confirmedCount      Int       @default(0) @map("confirmed_count")
  lastUnitPriceExVat  Decimal?  @map("last_unit_price_ex_vat") @db.Decimal(14, 4)
  lastSeenAt          DateTime? @map("last_seen_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  lines PurchaseInvoiceLine[]

  @@unique([supplierIdno, normalizedName])
  @@index([targetKind, targetId])
  @@map("supplier_item_mappings")
}

// ─── Unified stock (docs/UNIFIED-STOCK-PLAN.md, stage 1) ─────────────────────
// One model for every stock area. New categories (socks, bodysuits…) are data,
// not code. Legacy per-kind tables (mug, pen, garment…) move here in stages 2–4.

/// Physical place where stock is kept. One «Основной» row for now (id = "main").
model StockLocation {
  id        String   @id
  name      String
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  receipts  StockReceipt[]
  movements StockMovement[]

  @@map("stock_locations")
}

/// «Носки», «Боди», «Тонер»… Shown as a card on the Склад hub.
model StockCategory {
  id           String   @id @default(uuid())
  /// Stable slug used in URLs: socks, bodysuits, toner…
  code         String   @unique
  /// product | material | consumable — groups cards on the hub.
  kind         String
  nameRo       String   @map("name_ro")
  nameRu       String   @map("name_ru")
  nameEn       String   @map("name_en")
  /// Stock unit for every item in the category: pcs | m | ml | g | sheet
  unit         String
  /// Print methods that use this category as the printed item, e.g. ["dtf"].
  printMethods String[] @default([]) @map("print_methods")
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  items StockItem[]

  @@map("stock_categories")
}

/// A model / material / consumable, e.g. «Носки Fruit of the Loom белые». Stock lives on its variants.
model StockItem {
  id            String   @id @default(uuid())
  categoryId    String   @map("category_id")
  sku           String   @unique
  nameRo        String   @map("name_ro")
  nameRu        String   @map("name_ru")
  nameEn        String   @map("name_en")
  /// Storage key in the catalog bucket (catalog/stock/...).
  imageUrl      String?  @map("image_url")
  /// Category-specific details (fabric, gsm, roll width…).
  attributes    Json     @default("{}")
  /// Offered to clients on the future storefront.
  isSellable    Boolean  @default(false) @map("is_sellable")
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  internalNotes String?  @map("internal_notes") @db.Text
  /// Where the row came from when migrated from a legacy table (mug, pen, garment…).
  legacyKind    String?  @map("legacy_kind")
  legacyId      String?  @map("legacy_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  category StockCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants StockVariant[]

  @@unique([legacyKind, legacyId])
  @@index([categoryId, sortOrder])
  @@map("stock_items")
}

/// Colour + size (or the single variant of a plain item). Holds the balance and cost.
model StockVariant {
  id            String   @id @default(uuid())
  itemId        String   @map("item_id")
  sku           String   @unique
  /// Display label, e.g. «чёрный / M».
  label         String?
  /// { color?, colorHex?, size? }
  options       Json     @default("{}")
  /// Cached sum of movements, in the category unit.
  stockQuantity Decimal  @default(0) @map("stock_quantity") @db.Decimal(16, 6)
  /// Weighted-average purchase cost per unit (MDL).
  avgCost       Decimal? @map("avg_cost") @db.Decimal(14, 4)
  /// Manual cost hint used until the first receipt.
  purchaseCost  Decimal? @map("purchase_cost") @db.Decimal(14, 4)
  sellPrice     Decimal? @map("sell_price") @db.Decimal(12, 2)
  dealerPrice   Decimal? @map("dealer_price") @db.Decimal(12, 2)
  /// Run-size prices [{ minQty, priceMdl }] for printed apparel (DTF); same format as the legacy garment tiers.
  priceTiers    Json?    @map("price_tiers")
  /// Show «пора докупать» at or below this balance.
  reorderLevel  Decimal? @map("reorder_level") @db.Decimal(14, 3)
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  item         StockItem            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  receipts     StockReceipt[]
  movements    StockMovement[]
  printerSlots PrinterSlot[]
  orderLines   OrderLine[]
  designs      Design[]
  lfMaterial   LargeFormatMaterial? @relation("lfMaterialStock")
  sheetPaper   SheetPaper?          @relation("sheetPaperStock")

  @@index([itemId, sortOrder])
  @@map("stock_variants")
}

model StockReceipt {
  id                    String   @id @default(uuid())
  variantId             String   @map("variant_id")
  locationId            String   @default("main") @map("location_id")
  quantity              Decimal  @db.Decimal(16, 6)
  totalCostMdl          Decimal  @map("total_cost_mdl") @db.Decimal(14, 2)
  purchasedAt           DateTime @map("purchased_at") @db.Date
  supplierIdno          String?  @map("supplier_idno")
  supplierName          String?  @map("supplier_name")
  note                  String?  @db.Text
  /// Set when the receipt was posted from an incoming e-Factura line.
  purchaseInvoiceLineId String?  @unique @map("purchase_invoice_line_id")
  isProvisional         Boolean  @default(false) @map("is_provisional")
  amountsIncludeVat     Boolean  @default(false) @map("amounts_include_vat")
  createdById           String?  @map("created_by_id")
  createdAt             DateTime @default(now()) @map("created_at")

  variant             StockVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location            StockLocation        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  purchaseInvoiceLine PurchaseInvoiceLine? @relation(fields: [purchaseInvoiceLineId], references: [id], onDelete: SetNull)
  createdBy           User?                @relation("stockReceiptsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  movements           StockMovement[]

  @@index([variantId, purchasedAt(sort: Desc)])
  @@map("stock_receipts")
}

model StockMovement {
  id          String   @id @default(uuid())
  variantId   String   @map("variant_id")
  locationId  String   @default("main") @map("location_id")
  /// + receipt / return, − sale / write-off. In the category unit.
  delta       Decimal  @db.Decimal(16, 6)
  /// RECEIPT | RECEIPT_REVERSAL | ORDER_SALE | ORDER_RETURN | PROCUREMENT_BACKLOG | INVENTORY_ADJUSTMENT | WRITE_OFF | TRANSFER
  kind        String
  /// Receipt: purchase total; other kinds: |delta| × average cost at that moment.
  costMdl     Decimal? @map("cost_mdl") @db.Decimal(14, 2)
  orderId     String?  @map("order_id")
  orderNumber Int?     @map("order_number")
  orderLineId String?  @map("order_line_id")
  receiptId   String?  @map("receipt_id")
  note        String?  @db.Text
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  variant   StockVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location  StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  receipt   StockReceipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  order     Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy User?         @relation("stockMovementsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt(sort: Desc)])
  @@index([orderId])
  @@map("stock_movements")
}

/// A printer in the studio (wide-format, UV, DTF, Ricoh…). Its slots say which stock it consumes.
model Printer {
  id         String   @id @default(uuid())
  /// Stable code used by order code: lf | uv | dtf | ricoh
  code       String   @unique
  name       String
  /// roll_solvent | uv | dtf | toner_laser
  technology String
  isActive   Boolean  @default(true) @map("is_active")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  slots PrinterSlot[]

  @@map("printers")
}

/// One consumable position in a printer: an ink colour, a toner cartridge, film or powder.
model PrinterSlot {
  id            String   @id @default(uuid())
  printerId     String   @map("printer_id")
  /// «Cyan», «White», «Плёнка»…
  label         String
  /// ink | toner | film | powder
  role          String
  /// Stock variant currently loaded in this slot.
  variantId     String?  @map("variant_id")
  /// Ink: share of the printer's total ink use taken from this colour (0–1).
  share         Decimal? @db.Decimal(6, 4)
  /// Toner: printed sheets per one cartridge (yield).
  sheetsPerUnit Int?     @map("sheets_per_unit")
  sortOrder     Int      @default(0) @map("sort_order")

  printer Printer       @relation(fields: [printerId], references: [id], onDelete: Cascade)
  variant StockVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([printerId, label])
  @@map("printer_slots")
}

// ─── Print methods (docs/PRINT-METHODS-PLAN.md, stage B) ─────────────────────

/// A way of printing on an item priced by print size: DTF, UV… Settings hold the
/// method's norms and fees (JSON validated in code per method).
model PrintMethod {
  /// dtf | uv
  code        String   @id
  nameRo      String   @map("name_ro")
  nameRu      String   @map("name_ru")
  nameEn      String   @map("name_en")
  /// `Printer.code` whose consumables this method uses.
  printerCode String?  @map("printer_code")
  settings    Json     @default("{}")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  presets PrintPricePreset[]

  @@map("print_methods")
}

/// One print size in a method's price list (e.g. «A4 21×30» → 180 lei).
model PrintPricePreset {
  id          String   @id @default(uuid())
  methodCode  String   @map("method_code")
  label       String
  widthCm     Decimal  @map("width_cm") @db.Decimal(6, 2)
  heightCm    Decimal  @map("height_cm") @db.Decimal(6, 2)
  retailPrice Decimal  @map("retail_price") @db.Decimal(12, 2)
  dealerPrice Decimal? @map("dealer_price") @db.Decimal(12, 2)
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  method PrintMethod @relation(fields: [methodCode], references: [code], onDelete: Restrict)

  @@index([methodCode, isActive, sortOrder])
  @@map("print_price_presets")
}
